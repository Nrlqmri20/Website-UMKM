# Salin file ini jadi .env lalu isi nilainya.
# Setelah diubah, jalankan: node build-config.mjs

CC_BRAND=CodeCraft Digital
CC_TAGLINE=Bantu bisnis dan personal brand tampil lebih profesional di dunia digital.
CC_CITY=Banda Aceh

# Nomor WhatsApp format internasional tanpa tanda plus dan tanpa angka 0 di depan.
# Contoh: 6281234567890
CC_WA_NUMBER=

CC_EMAIL=hello@codecraft.example

CC_INSTAGRAM=
CC_TIKTOK=
CC_LINKEDIN=

# Domain untuk canonical, sitemap, dan Open Graph.
CC_BASE_URL=https://codecraft.example

CC_LEAD_MESSAGE=Halo CodeCraft Digital, saya mau konsultasi website untuk usaha saya.
