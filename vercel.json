{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node build-config.mjs",
  "outputDirectory": ".",
  "installCommand": "echo tidak ada dependensi",
  "redirects": [
    {
      "source": "/project",
      "destination": "/project/",
      "permanent": true
    },
    {
      "source": "/project2",
      "destination": "/project2/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/((?!assets/|project/|project2/).*)",
      "destination": "/index.html"
    }
  ]
}