# Catatan: .env sengaja ikut di-commit.
# Isinya hanya data kontak bisnis yang memang meant untuk publik.
# JANGAN pernah menaruh API key, token, atau password di file ini.
# Untuk nilai lokal sementara, pakai .env.local yang tetap diabaikan.

.env.local

# Dependensi
node_modules/
package-lock.json

# Log dan cache
*.log
npm-debug.log*
.cache/

# Berkas OS
.DS_Store
Thumbs.db
desktop.ini

# Berkas sementara
*.tmp
*.bak
*.swp

# Catatan kerja lokal
session-*.md
